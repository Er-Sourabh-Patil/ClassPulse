# Copy these into your shell environment before first launch.
CLASSPULSE_ADMIN_LOGIN=admin
CLASSPULSE_ADMIN_PASSWORD=replace-with-a-long-unique-password
CLASSPULSE_SECRET_KEY=replace-with-a-long-random-secret
CLASSPULSE_DEMO=0
# Optional: CLASSPULSE_DATABASE=/absolute/path/to/classpulse.db
# Optional: FLASK_DEBUG=0
